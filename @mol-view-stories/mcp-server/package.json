{
  "name": "@mol-view-stories/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for driving a locally running mol-view-stories editor via /api/dev/*",
  "type": "module",
  "bin": {
    "mvs-mcp": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prettier": "prettier --write ./src",
    "prettier:check": "prettier --check ./src",
    "tsc:check": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
